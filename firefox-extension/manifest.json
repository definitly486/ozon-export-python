{
  "manifest_version": 3,
  "name": "Ozon Bill — автоматическая выгрузка",
  "version": "1.1.10",
  "description": "Получает операции Ozon в фоновой вкладке Firefox и передаёт их в локальный Ozon Bill. Может автоматически заполнять сохранённый PIN.",
  "permissions": [
    "activeTab",
    "scripting",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://finance.ozon.ru/*",
    "https://*.ozon.ru/*",
    "https://ozon.ru/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ozon.ru/*",
        "https://ozon.ru/*"
      ],
      "js": [
        "pin-autofill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Загрузить операции Ozon в Ozon Bill"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ozon-bill-auto-import@local"
    }
  }
}