{
  "manifest_version": 3,
  "name": "Ozon Bill — импорт ПСБ",
  "version": "1.4.6",
  "description": "Импортирует выписку ПСБ из авторизованной вкладки Firefox в фоновой вкладке без переключения окна и выгрузкой максимально доступного периода.",
  "permissions": [
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://ib.psbank.ru/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Импортировать выписку ПСБ"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ozon-bill-psb-import@local"
    }
  }
}
