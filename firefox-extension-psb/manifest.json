{
  "manifest_version": 3,
  "name": "Ozon Bill — импорт ПСБ",
  "version": "1.1.0",
  "description": "Тихо открывает страницу выписки ПСБ в фоновой вкладке Firefox и импортирует CSV.",
  "permissions": ["tabs", "scripting", "notifications"],
  "host_permissions": [
    "https://ib.psbank.ru/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Импортировать выписку ПСБ"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ozon-bill-psb-import@local"
    }
  }
}